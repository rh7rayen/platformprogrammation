# Mode local explicite. Ne jamais activer en production.
APP_MODE=demo
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:4000
DEMO_DATA_DIR=.data/uniexam

# Mode connecté : APP_MODE=supabase
# Connexion dédiée qui peut SET ROLE uniexam_api ; SSL vérifié requis à distance.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_CA_FILE=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Réservée au script de provisionnement ; jamais NEXT_PUBLIC_*
SUPABASE_SECRET_KEY=

# IA désactivée par défaut. La génération transmet uniquement la consigne saisie.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
AI_DAILY_LIMIT=20

# Compilateurs : Judge0 privé sur machines dédiées. Voir docs/RUNNERS.md.
RUNNER_ENABLED=false
RUNNER_PROVIDER=judge0
RUNNER_BASE_URL=
RUNNER_AUTH_TOKEN=
RUNNER_LANGUAGE_IDS={}

# Vidéos : Supabase Storage privé. Aucun octet vidéo dans PostgreSQL.
# Clé serveur seulement ; jamais NEXT_PUBLIC_*.
RECORDINGS_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
RECORDINGS_BUCKET=exam-recordings
RECORDINGS_RETENTION_DAYS=30

# Invitations : domaine expéditeur vérifié et WEB_ORIGIN HTTPS public requis.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# 32 octets aléatoires encodés en base64, issus du gestionnaire de secrets.
EMAIL_ENCRYPTION_KEY=
