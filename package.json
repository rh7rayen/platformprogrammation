{
  "name": "uniexam",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend", "packages/contracts"],
  "engines": { "node": ">=24.18.0 <25" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @uniexam/contracts && npm run build -w @uniexam/backend && npm run build -w @uniexam/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test --test-concurrency=1 backend/test/*.test.ts",
    "test:e2e": "playwright test",
    "test:runner:live": "playwright test --config playwright.runner.config.ts",
    "runner:setup": "node scripts/local-runner.mjs bootstrap --pull",
    "runner:start": "node scripts/local-runner.mjs start",
    "runner:verify": "node scripts/local-runner.mjs verify",
    "db:migrate": "tsx backend/src/database/migrate.ts",
    "db:bootstrap": "tsx backend/src/database/bootstrap.ts"
  },
  "overrides": { "multer": "2.3.0", "dompurify": "3.4.15" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
