# Overlay these settings on the current reviewed Judge0 configuration on a
# DEDICATED Linux runner host. This file does not start containers locally.
# Replace every placeholder through your secret manager, not version control.
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
AUTHZ_TOKEN=REPLACE_WITH_A_DIFFERENT_ADMIN_SECRET
JUDGE0_TELEMETRY_ENABLE=false
ENABLE_WAIT_RESULT=false
ENABLE_COMPILER_OPTIONS=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_BATCHED_SUBMISSIONS=false
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
CPU_TIME_LIMIT=3
MAX_CPU_TIME_LIMIT=3
CPU_EXTRA_TIME=0.5
MAX_CPU_EXTRA_TIME=0.5
WALL_TIME_LIMIT=10
MAX_WALL_TIME_LIMIT=10
MEMORY_LIMIT=131072
MAX_MEMORY_LIMIT=524288
STACK_LIMIT=32768
MAX_STACK_LIMIT=32768
MAX_PROCESSES_AND_OR_THREADS=32
MAX_MAX_PROCESSES_AND_OR_THREADS=32
MAX_FILE_SIZE=16384
MAX_MAX_FILE_SIZE=16384
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
MAX_QUEUE_SIZE=100
# Set COUNT according to measured CPU/memory capacity; never unbounded.
COUNT=2
# Restrict ingress to your API/worker gateway IP addresses as well as firewall.
ALLOW_IP=REPLACE_WITH_PRIVATE_API_GATEWAY_IPS

# Required in the full Judge0 installation, each from a secret manager:
# POSTGRES_PASSWORD, REDIS_PASSWORD, SECRET_KEY_BASE
